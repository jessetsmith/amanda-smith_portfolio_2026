# Copy to .env.local and fill in real values. Never commit .env.local.
# GitHub Pages builds bake NEXT_PUBLIC_* (+ optional SANITY_API_READ_TOKEN)
# from Actions secrets/vars at build time — see .github/DEPLOY.md.

# Sanity (https://www.sanity.io/) — leave PROJECT_ID blank to use local fixtures
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only Sanity tokens — never expose in client bundles
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# CI only (GitHub Actions): Sanity deploy token with deployStudio grant.
# Create in Manage → API → Tokens. Used by `npm run sanity:studio-register`.
# SANITY_AUTH_TOKEN=

# Admin session signing secret (server-only, >= 32 chars). Generate with:
#   openssl rand -base64 48
# If unset, the key is derived from SANITY_API_WRITE_TOKEN. If neither is set,
# production refuses admin login; local dev uses an insecure dev secret with a warning.
# Changing this value signs every admin out.
ADMIN_SESSION_SECRET=

# Optional emergency bootstrap for /admin ONLY if Sanity confirms the adminAuth doc
# does not exist (or local dev without Sanity). A Sanity read error refuses login (503).
# Primary auth: bcrypt hash in Sanity singleton `adminAuth` (npm run sanity:seed-admin).
# Leave unset in production once seeded.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Holistic translate (optional; stub works without this)
GOOGLE_TRANSLATE_API_KEY=

