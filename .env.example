# Copy to .env.local and fill in real values. Never commit .env.local.
# For Vercel production/preview, set the same keys in the Vercel project
# Environment Variables UI (see .github/DEPLOY.md). GitHub Actions CI uses
# empty Sanity IDs so the fixture build still passes.

# Sanity (https://www.sanity.io/) — leave PROJECT_ID blank to use local fixtures
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only Sanity tokens — never expose in client bundles
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Placeholder /admin login (local fixture editing — not production auth)
# Change these on any shared Vercel deploy.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Holistic translate (optional; stub works without this)
GOOGLE_TRANSLATE_API_KEY=

