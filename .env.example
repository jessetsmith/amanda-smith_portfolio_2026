# Copy to .env.local and fill in real values. Never commit .env.local.
# GitHub Pages builds bake NEXT_PUBLIC_* (+ optional SANITY_API_READ_TOKEN)
# from Actions secrets/vars at build time — see .github/DEPLOY.md.

# Sanity (https://www.sanity.io/) — leave PROJECT_ID blank to use local fixtures
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only Sanity tokens — never expose in client bundles
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# CI only (GitHub Actions): Sanity deploy token with deployStudio grant.
# Create in Manage → API → Tokens. Used by `npm run sanity:studio-register`.
# SANITY_AUTH_TOKEN=

# Optional emergency bootstrap for /admin ONLY if Sanity adminAuth doc is missing.
# Primary auth: bcrypt hash in Sanity singleton `adminAuth` (npm run sanity:seed-admin).
# Leave unset in production once seeded.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Holistic translate (optional; stub works without this)
GOOGLE_TRANSLATE_API_KEY=

