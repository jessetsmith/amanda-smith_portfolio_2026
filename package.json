{
  "name": "portfolio_2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run sanity:manifest-extract",
    "build": "next build",
    "build:pages": "node scripts/pages-static-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sanity:seed": "node scripts/seed-sanity.mjs",
    "sanity:seed-i18n": "node scripts/seed-i18n.mjs",
    "sanity:seed-admin": "node scripts/seed-admin-auth.mjs",
    "sanity:migrate-hero-poster": "node scripts/migrate-hero-poster-to-sanity.mjs",
    "sanity:schema-extract": "sanity schemas extract --path ./schema.json --force",
    "sanity:schema-validate": "sanity schemas validate",
    "sanity:schema-deploy": "sanity schemas deploy",
    "sanity:manifest-extract": "sanity manifest extract --path public/studio/static && node scripts/prune-studio-static.mjs",
    "sanity:studio-register": "sanity deploy --external --url https://portfolio.bittersweetwoman.com/studio --schema-required --yes"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^8.9.0",
    "bcryptjs": "^3.0.3",
    "next": "16.4.0",
    "next-sanity": "^13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.19.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
